rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Equipment catalog - readable and manageable by department users and admins
    match /equipments/{equipmentId} {
      allow read, write: if true;
    }

    // Bookings collection - booking requests, approvals, and returns
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Admin emails directory
    match /admin_emails/{emailId} {
      allow read, write: if true;
    }

    // Default match for other collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
